+// task3.patch 6: how many valid L2C lines also have a valid copy in the LLC (0 means the LLC is exclusive)
+extern CACHE LLC, cpu0_L2C;
+void print_exclusivity()
+{
+  uint64_t both = 0, valid = 0;
+  for (auto& b : cpu0_L2C.block) {
+    if (!b.valid)
+      continue;
+    valid++;
+    if (LLC.get_way(b.address, LLC.get_set(b.address)) < LLC.NUM_WAY)
+      both++;
+  }
+  cout << "L2C LINES ALSO IN LLC: " << both << " of " << valid << endl;
+}
